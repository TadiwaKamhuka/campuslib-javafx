<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER"
      spacing="14"
      styleClass="root">

    <VBox alignment="CENTER"
          spacing="14"
          maxWidth="380"
          styleClass="card"
          VBox.vgrow="NEVER">

        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <Label text="CampusLib" styleClass="page-title"/>
        <Label text="Library Management System"
               styleClass="page-subtitle"/>

        <VBox spacing="6" styleClass="form-field">
            <Label text="Username" styleClass="form-label"/>
            <TextField promptText="Enter your username"
                       styleClass="input-field"/>
        </VBox>

        <VBox spacing="6" styleClass="form-field">
            <Label text="Password" styleClass="form-label"/>
            <PasswordField promptText="Enter your password"
                           styleClass="input-field"/>
        </VBox>

        <Label text="" styleClass="error-label"/>

        <Button text="Login"
                maxWidth="Infinity"
                styleClass="button, primary-button"/>
    </VBox>
</VBox>
