<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="20">

    <VBox styleClass="page-header">
        <Label text="Books"
               styleClass="page-title"/>

        <Label text="Browse the CampusLib book catalog."
               styleClass="page-subtitle"/>
    </VBox>

    <!-- TODO: Replace this placeholder with the approved Books
         layout and BookService data after backend integration. -->
    <VBox styleClass="card">
        <Label text="No books found."
               styleClass="empty-state"
               maxWidth="Infinity"/>

        <Label text="Book catalog integration is not available in this preview."
               styleClass="page-subtitle"
               wrapText="true"/>
    </VBox>
</VBox>