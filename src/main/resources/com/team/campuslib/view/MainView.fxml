<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.team.campuslib.controller.MainController">

    <left>
        <VBox styleClass="sidebar"
              minWidth="240"
              prefWidth="240"
              maxWidth="240">

            <Label text="CampusLib"
                   styleClass="sidebar-logo"/>

            <Button fx:id="dashboardButton"
                    text="Dashboard"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#handleDashboard"/>

            <Button fx:id="booksButton"
                    text="Books"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#handleBooks"/>

            <Button fx:id="membersButton"
                    text="Members"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#handleMembers"/>

            <Button fx:id="loansButton"
                    text="Loans"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#handleLoans"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label fx:id="accountLabel"
                   styleClass="page-subtitle"
                   wrapText="true"/>

            <Button text="Logout"
                    styleClass="nav-button"
                    maxWidth="Infinity"
                    onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area">

            <Label fx:id="navigationErrorLabel"
                   styleClass="error-label"
                   visible="false"
                   managed="false"
                   wrapText="true"/>

            <StackPane fx:id="contentArea"
                       VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>