<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="20">

    <VBox styleClass="page-header">
        <Label text="Loans"
               styleClass="page-title"/>

        <Label text="View borrowing and return information."
               styleClass="page-subtitle"/>
    </VBox>

    <!-- TODO: Replace this placeholder with the approved Loans
         layout and LoanService data after backend integration. -->
    <VBox styleClass="card">
        <Label text="No loans found."
               styleClass="empty-state"
               maxWidth="Infinity"/>

        <Label text="Borrowing and returns are not available in this preview."
               styleClass="page-subtitle"
               wrapText="true"/>
    </VBox>
</VBox>