<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="campuslib-persistence" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.team.campuslib.model.User</class>
        <class>com.team.campuslib.model.Book</class>
        <class>com.team.campuslib.model.Member</class>
        <class>com.team.campuslib.model.Loan</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:sqlite:campuslib.db"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.community.dialect.SQLiteDialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>

    </persistence-unit>
</persistence>
